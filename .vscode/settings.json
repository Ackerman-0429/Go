{
  // Go 代码保存时自动格式化 + 自动整理 import
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  // 静态检查只保留 gopls 服务端一份（见下方 ui.diagnostic.staticcheck）。
  // 不要再配 go.lintTool / go.lintOnSave，否则客户端会再跑一遍，产生重复诊断。
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "ui.diagnostic.staticcheck": true,
    // gf gen dao 生成的 entity/do 固定使用 Id 字段，与 ST1003（要求缩略词全大写 ID）
    // 天然冲突。业务代码已手动遵守规范，故关闭该规则，避免十几个生成文件持续刷警告。
    "ui.diagnostic.analyses": {
      "ST1003": false
    }
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true
}
