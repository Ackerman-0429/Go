{
  // Go 代码保存时自动格式化 + 自动整理 import
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  // 静态检查只保留 gopls 服务端一份（见下方 ui.diagnostic.staticcheck）。
  // 不要再配 go.lintTool / go.lintOnSave，否则客户端会再跑一遍，产生重复诊断。
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true,
    "ui.diagnostic.staticcheck": true,
    // 关闭两条与 GoFrame 代码生成冲突的规则：
    // ST1003 命名：gf gen dao 生成的 entity/do 固定用 Id 字段，重新生成会覆盖手改
    // ST1000 包注释：api/hello、internal/cmd/dao/model 等生成包均无包注释，且标记 DO NOT EDIT
    // 业务代码仍按规范书写并在包内保留了 Package 注释。
    "ui.diagnostic.analyses": {
      "ST1003": false,
      "ST1000": false
    }
  },
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true
}
