{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "go: build",
      "type": "shell",
      "command": "go build -o goshop.exe .",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go: run",
      "type": "shell",
      "command": "go run .",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
